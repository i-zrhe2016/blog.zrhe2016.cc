{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "astro-paper",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/admin",
      "/admin/*",
      "/api/admin/*",
      "/api/comments",
      "/mcp",
    ],
  },
  "d1_databases": [
    {
      "binding": "COMMENTS_DB",
      "database_name": "blog-comments",
      "database_id": "f352e6b6-256f-44a4-86bd-b98be6930aca",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {},
  "main": "worker/index.ts",
  "vars": {
    "GITHUB_REPO": "i-zrhe2016/blog.zrhe2016.cc",
    "GITHUB_BRANCH": "main",
    "ADMIN_ORIGIN": "https://blog.zrhe2016.cc",
    "MCP_PREVIEW_BRANCH": "preview",
    "PREVIEW_ORIGIN": "https://preview-astro-paper.zrhe2016.workers.dev",
  },
}
