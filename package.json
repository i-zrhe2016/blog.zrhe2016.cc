{
  "name": "astro-paper",
  "type": "module",
  "version": "6.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "diagrams:render": "node scripts/render-plantuml.mjs",
    "dev": "astro dev",
    "build": "node scripts/render-plantuml-remote.mjs && node scripts/render-plantuml.mjs --check && astro check && astro build && pagefind --site dist && node scripts/copy-pagefind.mjs && node scripts/admin-build.mjs",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "admin:dev": "pnpm build && wrangler dev --local",
    "test": "tsx --test tests/admin.test.ts tests/mcp.test.ts",
    "test:admin": "tsx --test tests/admin.test.ts",
    "test:mcp": "tsx --test tests/mcp.test.ts",
    "test:admin:browser": "tsx --test tests/admin-browser.test.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.38.6",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.3",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.21",
    "jose": "^6.1.1",
    "lodash.kebabcase": "^4.1.1",
    "rehype-callouts": "^2.2.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-collapse": "^0.1.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.2",
    "shiki": "4.3.0",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.2",
    "unified": "^11.0.5",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "3.0.5",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "pagefind": "^1.5.2",
    "plantuml-cli": "1.2026.8",
    "playwright": "1.64.0",
    "prettier": "3.9.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "wrangler": "^4.0.0"
  }
}
