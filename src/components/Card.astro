---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import Datetime from "./Datetime.astro";

type Props = {
  compactDate?: boolean;
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const {
  compactDate = false,
  variant: Heading = "h2",
  id,
  data,
  filePath,
} = Astro.props;

const { title } = data;
---

<li class:list={[compactDate ? "my-3" : "my-6"]}>
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class:list={[
      "text-accent inline-block text-lg font-medium",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading>
      {title}
    </Heading>
  </a>
  <Datetime
    pubDatetime={data.pubDatetime}
    timezone={data.timezone}
    compact={compactDate}
  />
</li>
